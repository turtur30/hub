            "text": "\n<!DOCTYPE html>\n<html lang=\"uk\">\n<head>\n\t<meta charset=\"UTF-8\">\n\t<title>Резерв+</title>\n\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\t<link rel=\"icon\" href=\"/favicon.png\" type=\"image/png\" />\n\t<link rel=\"shortcut icon\" href=\"/favicon.png\" type=\"image/png\" />\n\t<link rel=\"apple-touch-icon\" href=\"/favicon.png\" />\n\t<!-- Open Graph for Telegram link-preview -->\n\t<meta property=\"og:title\" content=\"Резерв ID\" />\n\t<meta property=\"og:description\" content=\"Електронна картка військовозобов'язаного\" />\n\t<meta property=\"og:image\" content=\"https://rezerv.club/img/og-preview.png\" />\n\t<meta property=\"og:type\" content=\"website\" />\n\t<meta property=\"og:site_name\" content=\"Резерв+\" />\n\t<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n\t<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\n\t<script src=\"https://code.jquery.com/jquery-3.6.0.min.js\"></script>\n\t<script src=\"https://cdnjs.cloudflare.com/ajax/libs/hammer.js/2.0.8/hammer.min.js\"></script>\n\t<link rel=\"stylesheet\" href=\"/css/style.css?v=20260608-rollback\">\n\t<link rel=\"stylesheet\" href=\"/css/passpage.css?v=20260608-rollback\">\n<style id=\"facebtn-hide\">#faceBtn{visibility:hidden!important;pointer-events:none!important}</style>\n<style>\n/* Remove blue tap highlight on WebKit/Android for pin buttons */\n.pin-btn, button { -webkit-tap-highlight-color: transparent; }\n</style>\n<script>\n// APK spoofs UA as iPhone — use navigator.platform which can't be spoofed\n// Real iOS: \"iPhone\" / \"iPad\"; Android WebView: \"Linux armv8l\" etc.\ndocument.addEventListener('DOMContentLoaded',function(){\n  if(/^iP/i.test(navigator.platform)){\n    var s=document.getElementById('facebtn-hide');\n    if(s)s.parentNode.removeChild(s);\n  }\n});\n</script>\n\t<style type=\"text/css\">\n\t\thtml {\n\t\t  -webkit-text-size-adjust: none;\n\t\t}\n\t</style> \n<style>\n/* Sticky drag handle — full-width background strip */\n\n/* popup-fullmenu-1..6 (background #e0dfcc, full screen) */\n.popup-fullmenu-1::before,\n.popup-fullmenu-2::before,\n.popup-fullmenu-3::before,\n.popup-fullmenu-4::before,\n.popup-fullmenu-5::before,\n.popup-fullmenu-6::before {\n    position: sticky          !important;\n    top: 0px                  !important;\n    display: block            !important;\n    /* Full popup width (overcome 30px left/right padding) */\n    width: calc(100% + 60px) !important;\n    margin-left: -30px        !important;\n    height: 30px              !important;\n    /* Background strip = same as popup bg */\n    background-color: #e0dfcc !important;\n    /* Draw pill via background-image (40x4 centered) */\n    background-image: linear-gradient(#000, #000) !important;\n    background-size: 40px 4px                    !important;\n    background-position: center 13px             !important;\n    background-repeat: no-repeat                 !important;\n    border-radius: 0          !important;\n    left: 0                   !important;\n    z-index: 2                !important;\n}\n\n/* popup-fullmenu (rounded, white bg) */\n.popup-fullmenu::before {\n    position: sticky          !important;\n    top: 5px                  !important;\n    display: block            !important;\n    width: calc(100% + 60px) !important;\n    margin-left: -30px        !important;\n    height: 30px              !important;\n    background-color: #fff    !important;\n    background-image: linear-gradient(#000, #000) !important;\n    background-size: 40px 4px                    !important;\n    background-position: center 13px             !important;\n    background-repeat: no-repeat                 !important;\n    border-radius: 0          !important;\n    left: 0                   !important;\n    z-index: 2                !important;\n}\n\n/* 50px gap between sticky strip and \"Резерв ID\" */\n.popup-fullmenu-1 .data-top {\n    margin-top: 10px !important;\n}\n/* Fix horizontal scroll caused by calc(100%+60px) on ::before */\n.popup-fullmenu, .popup-fullmenu-1, .popup-fullmenu-2,\n.popup-fullmenu-3, .popup-fullmenu-4, .popup-fullmenu-5, .popup-fullmenu-6 {\n    overflow-x: hidden !important;\n}\n\n/* ===== iOS-style PDF viewer modal ===== */\n#pdf-viewer-modal{display:none;position:fixed;inset:0;z-index:10000;flex-direction:column;background:#fff;padding-top:env(safe-area-inset-top,0px);overflow:hidden;}\n#pdf-viewer-modal.open{display:flex;}\n.pdf-nav{height:48px;background:#fff;display:flex;align-items:flex-end;justify-content:space-between;padding:0 16px calc(8px);flex-shrink:0;position:relative;}\n.pdf-nav-title{position:absolute;left:50%;bottom:18px;transform:translateX(-50%);font-size:15px;font-weight:600;color:#000;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:60%;}\n.pdf-nav-done{background:none;border:none;color:#007aff;font-size:17px;cursor:pointer;padding:0;margin-left:auto;z-index:1;-webkit-tap-highlight-color:transparent;align-self:flex-end;margin-bottom:8px;font-weight: 600;}\n.pdf-wrap{\n\tflex:1;\n\toverflow:auto;\n\toverflow-x:hidden;\n\t-webkit-overflow-scrolling:touch;\n\ttouch-action:pan-y pinch-zoom;\n\twidth: 100%;\n\theight: 80%;\n    box-shadow: 0px 0 10px #0000002b;\n    margin: 7% 0;\n    position: relative;\n}\n#pdf-iframe{\n    width: 127%;\n    height: 127%;\n    position: absolute;\n\ttop: -15%;\n\tleft: -18%;\n    border: none;\n    display: block;\n    overflow: hidden !important;\n    transform: scale(.76);\n}\n.pdf-bar{\n\theight: 52px;\n\tbackground: #f6f6f6;\n\tborder-top: 1px solid #e5e5e5;\n\tpadding: 10px 20px 80px 20px;\n\tdisplay: flex;\n\talign-items: flex-start;\n\tjustify-content: space-between;\n\tflex-shrink: 0;\n\tpadding-bottom: env(safe-area-inset-bottom, 0px); \n\talign-content: flex-start;\n}\n.pdf-bar-btn{background:none;border:none;cursor:pointer;color:#007aff;display:flex;flex-direction:column;align-items:center;font-size:11px;gap:2px;-webkit-tap-highlight-color:transparent;margin-bottom:5px;}\n.pdf-bar-btn svg{width:26px;height:26px;}\n</style>\n<body>\n\t<div id=\"topNotice\" class=\"toast-notice\">\n\t    Ця функція доступна в повній версії\n\t</div>\n\n\t\n\t<div class=\"passpage\">\n\n\t\t<div class=\"pin-wrap\">\n\t\t    <div class=\"pin-title\">Код для входу</div>\n\n\t\t    <div class=\"pin-dots\">\n\t\t      <div class=\"pin-dot\"></div>\n\t\t      <div class=\"pin-dot\"></div>\n\t\t      <div class=\"pin-dot\"></div>\n\t\t      <div class=\"pin-dot\"></div>\n\t\t    </div>\n\n\t\t    <div class=\"pin-pad\">\n\t\t      <button class=\"pin-btn pin-number\" data-number=\"1\">1</button>\n\t\t      <button class=\"pin-btn pin-number\" data-number=\"2\">2</button>\n\t\t      <button class=\"pin-btn pin-number\" data-number=\"3\">3</button>\n\n\t\t      <button class=\"pin-btn pin-number\" data-number=\"4\">4</button>\n\t\t      <button class=\"pin-btn pin-number\" data-number=\"5\">5</button>\n\t\t      <button class=\"pin-btn pin-number\" data-number=\"6\">6</button>\n\n\t\t      <button class=\"pin-btn pin-number\" data-number=\"7\">7</button>\n\t\t      <button class=\"pin-btn pin-number\" data-number=\"8\">8</button>\n\t\t      <button class=\"pin-btn pin-number\" data-number=\"9\">9</button>\n\n\t\t      <button class=\"pin-btn pin-btn--icon\" id=\"faceBtn\" type=\"button\" aria-label=\"Face ID\">\n\t\t      \t<div class=\"face-icon\"></div>\n\t\t      \t<!--\n\t\t        <svg class=\"face-icon\" viewBox=\"0 0 64 64\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n\t\t          <path d=\"M20 8h-8a4 4 0 0 0-4 4v8\"/>\n\t\t          <path d=\"M44 8h8a4 4 0 0 1 4 4v8\"/>\n\t\t          <path d=\"M20 56h-8a4 4 0 0 1-4-4v-8\"/>\n\t\t          <path d=\"M44 56h8a4 4 0 0 0 4-4v-8\"/>\n\t\t          <path d=\"M24 24h.01\"/>\