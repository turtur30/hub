ss=\"button\">\n    \t\t\t\t<a href=\"#\" class=\"popup-fullscreen-close\">Зрозуміло</a>\n    \t\t\t</div>\n    \t\t</div>\n    \t</div>\n    </div>\n\n\t\n\n\n\n<script>\n/* Swipe down to close bottom-sheet popups (v3 — smooth) */\n(function() {\n    var SHEET_SEL = '.popup-fullmenu, .popup-fullmenu-1, .popup-fullmenu-2, ' +\n                   '.popup-fullmenu-3, .popup-fullmenu-4, .popup-fullmenu-5, .popup-fullmenu-6';\n    var THRESHOLD   = 80;\n    var EASE_CLOSE  = 'transform 0.28s cubic-bezier(0.4, 0, 0.8, 1)';   /* ease-in  */\n    var EASE_CANCEL = 'transform 0.35s cubic-bezier(0.25, 0.8, 0.25, 1)'; /* ease-out */\n\n    function getMaxScroll(sheet) {\n        var max = sheet.scrollTop;\n        sheet.querySelectorAll('*').forEach(function(el) {\n            if (el.scrollTop > max) max = el.scrollTop;\n        });\n        return max;\n    }\n\n    function closeAll() {\n        document.querySelectorAll(SHEET_SEL).forEach(function(s) {\n            s.classList.remove('active');\n        });\n        if (typeof $ !== 'undefined') { $('.overlay').fadeOut(150); }\n    }\n\n    function initSwipe(sheet) {\n        var startY = 0, startScroll = 0, delta = 0, dragging = false;\n\n        sheet.addEventListener('touchstart', function(e) {\n            /* Stop any ongoing animation */\n            sheet.style.transition = 'none';\n            sheet.style.transform  = sheet.style.transform || '';\n            startY      = e.touches[0].clientY;\n            startScroll = getMaxScroll(sheet);\n            delta       = 0;\n            dragging    = false;\n        }, { passive: true });\n\n        sheet.addEventListener('touchmove', function(e) {\n            delta = e.touches[0].clientY - startY;\n\n            if (delta > 0 && startScroll <= 1) {\n                dragging = true;\n                /* Resistance: full speed up to 60px, then slow down */\n                var visual = delta < 60\n                    ? delta\n                    : 60 + (delta - 60) * 0.35;\n                sheet.style.transition = 'none';\n                sheet.style.transform  = 'translateY(' + visual + 'px)';\n\n            } else if (dragging) {\n                /* Direction reversed — snap back */\n                dragging = false;\n                sheet.style.transition = EASE_CANCEL;\n                sheet.style.transform  = 'translateY(0)';\n            }\n        }, { passive: true });\n\n        sheet.addEventListener('touchend', function() {\n            if (dragging && delta > THRESHOLD) {\n                /* Animate off-screen first, THEN remove active class */\n                sheet.style.transition = EASE_CLOSE;\n                sheet.style.transform  = 'translateY(110%)';\n                setTimeout(function() {\n                    closeAll();\n                    /* Reset silently after class is removed */\n                    sheet.style.transition = 'none';\n                    sheet.style.transform  = '';\n                    /* Restore default transition on next frame */\n                    requestAnimationFrame(function() {\n                        sheet.style.transition = '';\n                    });\n                }, 290);\n            } else {\n                /* Snap back smoothly */\n                sheet.style.transition = EASE_CANCEL;\n                sheet.style.transform  = 'translateY(0)';\n                setTimeout(function() {\n                    sheet.style.transition = '';\n                    sheet.style.transform  = '';\n                }, 360);\n            }\n            dragging = false;\n            delta    = 0;\n        }, { passive: true });\n    }\n\n    function setup() {\n        document.querySelectorAll(SHEET_SEL).forEach(initSwipe);\n    }\n\n    if (document.readyState === 'loading') {\n        document.addEventListener('DOMContentLoaded', setup);\n    } else {\n        setup();\n    }\n})();\n</script>\n<script>\n/* Show overlay when \"Переглянути документ\" opens popup-fullmenu-1 */\ndocument.addEventListener('DOMContentLoaded', function() {\n    var btn = document.getElementById('menu-1');\n    if (btn && typeof $ !== 'undefined') {\n        btn.addEventListener('click', function() {\n            /* Small delay so existing handler runs first */\n            setTimeout(function() { $('.overlay').fadeIn(100); }, 30);\n        });\n    }\n});\n</script>\n\n<!-- iOS-style PDF viewer modal -->\n<div id=\"pdf-viewer-modal\">\n  <div class=\"pdf-nav\">\n    <span class=\"pdf-nav-title\">&#1042;&#1110;&#1081;&#1089;&#1100;&#1082;&#1086;&#1074;&#1086;-&#1086;&#1073;&#1083;&#1110;&#1082;&#1086;&#1074;&#1080;&#1081; &#1076;&#1086;&#1082;&#1091;&#1084;&#1077;&#1085;&#1090;</span>\n    <button class=\"pdf-nav-done\" onclick=\"closePDFModal()\">Done</button>\n  </div>\n  <div class=\"pdf-wrap\">\n    <iframe id=\"pdf-iframe\" src=\"\" allow=\"fullscreen\"></iframe>\n  </div>\n  <div class=\"pdf-bar\">\n    <button class=\"pdf-bar-btn\" onclick=\"sharePDF()\" aria-label=\"Share\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" width=\"26\" height=\"26\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12\"/></svg>\n    </button>\n    <button class=\"pdf-bar-btn\" aria-label=\"Search\" >\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path stroke-linecap=\"round\" d=\"M21 21l-4.35-4.35\"/></svg>\n    </button>\n  </div>\n</div>\n\n<script>\n(function(){\n  /* Only intercept click on iOS */\n  var isIOS = /^iP/i.test(navigator.platform) ||\n              (/Mac/.test(navigator.platform) && navigator.maxTouchPoints > 1);\n  if (!isIOS) return;\n\n  var _pdfUrl = '';\n\n  /* Override menu-2 click */\n  document.addEventListener('DOMContentLoaded', function(){\n    var link = document.querySelector('#menu-2 a');\n    if (!link) return;\n    link.addEventListener('click', function(e){\n      e.preventDefault();\n      e.stopPropagation();\n      _pdfUrl = link.href;\n      openPDFModal(_pdfUrl + '?view=1');\n    });\n  });\n\n  window.openPDFModal = function(src){\n    /* Allow pinch-zoom in modal */\n    var vm = document.querySelector('meta[name=\"viewport\"]');\n    if (vm) vm._orig = vm.getAttribute('content');\n    if (vm) vm.setAttribute('content',\n      'width=device-width, initial-scale=1');\n    /* Fix status bar: switch from black-translucent to default (white) */\n    var sbm = document.querySelector('meta[name=\"apple-mobile-web-app-status-bar-style\"]');\n    if (sbm) { sbm._orig = sbm.getAttribute('content'); sbm.setAttribute('content', 'default'); }\n    /* theme-color white for Chrome/Android */\n    var tc = document.querySelector('meta[name=\"theme-color\"]') || document.createElement('meta');\n    tc.name = 'theme-color'; tc.id = 'tcm'; tc.content = '#ffffff';\n    if (!document.getElementById('tcm')) document.head.appendChild(tc);\n    document.getElementById('pdf-iframe').src = src + '#view=FitH';\n    document.getElementById('pdf-viewer-modal').classList.add('open');\n    document.body.style.overflow = 'hidden';\n  };\n\n  window.closePDFModal = function(){\n    document.getElementById('pdf-viewer-modal').classList.remove('open');\n    document.getElementById('pdf-iframe').src = '';\n    document.body.style.overflow = '';\n    /* Restore viewport */\n    var vm = document.querySelector('meta[name=\"viewport\"]');\n    if (vm && vm._orig) vm.setAttribute('content', vm._orig);\n    /* Restore status bar */\n    var sbm = document.querySelector('meta[name=\"apple-mobile-web-app-status-bar-style\"]');\n    if (sbm && sbm._orig) sbm.setAttribute('content', sbm._orig);\n    var tc = document.getElementById('tcm');\n    if (tc) tc.parentNode.removeChild(tc);\n  };\n\n  window.sharePDF = function(){\n    if (navigator.share){\n      navigator.share({\n        title: 'Військово-обліковий документ',\n        url: _pdfUrl\n      });\n    } else {\n      window.open(_pdfUrl, '_blank');\n    }\n  };\n\n\n\n  /* Close modal on background tap (not on content) */\n  document.getElementById('pdf-viewer-modal').addEventListener('click', function(e){\n    if (e.target === this) closePDFModal();\n  });\n})();\n</script>\n<script src=\"/js/app.js?v=20261007-card\" defer></script>\n<script src=\"/js/passpage.js?v=20260608-rollback\" defer></script>\n<script type=\"module\" src=\"https://static.cloudflareinsights.com/beacon.min.js/v4bc70e2c01a94c73b74392e4234840661791215815920\" integrity=\"sha512-L0ha0OXavK/8okipN9F8BtP84dg9DUhPERbBXzwI6dgTA55d2+yweo3pn5CSFYs45/r8md2+xvUPtTdvTNRfjA==\" data-cf-beacon='{\"version\":\"2024.11.0\",\"token\":\"d61e81cc39e5461582f0e8306bff09b0\",\"r\":1,\"spa\":2}' crossorigin=\"anonymous\"></script>\n</body>\n</html>\n\n"
