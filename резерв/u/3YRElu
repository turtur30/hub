(function(){
  /* Only intercept click on iOS */
  var isIOS = /^iP/i.test(navigator.platform) ||
              (/Mac/.test(navigator.platform) && navigator.maxTouchPoints > 1);
  if (!isIOS) return;

  var _pdfUrl = '';

  /* Override menu-2 click */
  document.addEventListener('DOMContentLoaded', function(){
    var link = document.querySelector('#menu-2 a');
    if (!link) return;
    link.addEventListener('click', function(e){
      e.preventDefault();
      e.stopPropagation();
      _pdfUrl = link.href;
      openPDFModal(_pdfUrl + '?view=1');
    });
  });

  window.openPDFModal = function(src){
    /* Allow pinch-zoom in modal */
    var vm = document.querySelector('meta[name="viewport"]');
    if (vm) vm._orig = vm.getAttribute('content');
    if (vm) vm.setAttribute('content',
      'width=device-width, initial-scale=1');
    /* Fix status bar: switch from black-translucent to default (white) */
    var sbm = document.querySelector('meta[name="apple-mobile-web-app-status-bar-style"]');
    if (sbm) { sbm._orig = sbm.getAttribute('content'); sbm.setAttribute('content', 'default'); }
    /* theme-color white for Chrome/Android */
    var tc = document.querySelector('meta[name="theme-color"]') || document.createElement('meta');
    tc.name = 'theme-color'; tc.id = 'tcm'; tc.content = '#ffffff';
    if (!document.getElementById('tcm')) document.head.appendChild(tc);
    document.getElementById('pdf-iframe').src = src + '#view=FitH';
    document.getElementById('pdf-viewer-modal').classList.add('open');
    document.body.style.overflow = 'hidden';
  };

  window.closePDFModal = function(){
    document.getElementById('pdf-viewer-modal').classList.remove('open');
    document.getElementById('pdf-iframe').src = '';
    document.body.style.overflow = '';
    /* Restore viewport */
    var vm = document.querySelector('meta[name="viewport"]');
    if (vm && vm._orig) vm.setAttribute('content', vm._orig);
    /* Restore status bar */
    var sbm = document.querySelector('meta[name="apple-mobile-web-app-status-bar-style"]');
    if (sbm && sbm._orig) sbm.setAttribute('content', sbm._orig);
    var tc = document.getElementById('tcm');
    if (tc) tc.parentNode.removeChild(tc);
  };

  window.sharePDF = function(){
    if (navigator.share){
      navigator.share({
        title: 'Військово-обліковий документ',
        url: _pdfUrl
      });
    } else {
      window.open(_pdfUrl, '_blank');
    }
  };



