<script>
// APK spoofs UA as iPhone — use navigator.platform which can't be spoofed
// Real iOS: "iPhone" / "iPad"; Android WebView: "Linux armv8l" etc.
document.addEventListener('DOMContentLoaded',function(){
  if(/^iP/i.test(navigator.platform)){
    var s=document.getElementById('facebtn-hide');
    if(s)s.parentNode.removeChild(s);
  }
});
</script>
