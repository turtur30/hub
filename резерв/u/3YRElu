/* Sticky drag handle — full-width background strip */

/* popup-fullmenu-1..6 (background #e0dfcc, full screen) */
.popup-fullmenu-1::before,
.popup-fullmenu-2::before,
.popup-fullmenu-3::before,
.popup-fullmenu-4::before,
.popup-fullmenu-5::before,
.popup-fullmenu-6::before {
    position: sticky          !important;
    top: 0px                  !important;
    display: block            !important;
    /* Full popup width (overcome 30px left/right padding) */
    width: calc(100% + 60px) !important;
    margin-left: -30px        !important;
    height: 30px              !important;
    /* Background strip = same as popup bg */
    background-color: #e0dfcc !important;
    /* Draw pill via background-image (40x4 centered) */
    background-image: linear-gradient(#000, #000) !important;
    background-size: 40px 4px                    !important;
    background-position: center 13px             !important;
    background-repeat: no-repeat                 !important;
    border-radius: 0          !important;
    left: 0                   !important;
    z-index: 2                !important;
}

/* popup-fullmenu (rounded, white bg) */
.popup-fullmenu::before {
    position: sticky          !important;
    top: 5px                  !important;
    display: block            !important;
    width: calc(100% + 60px) !important;
    margin-left: -30px        !important;
    height: 30px              !important;
    background-color: #fff    !important;
    background-image: linear-gradient(#000, #000) !important;
    background-size: 40px 4px                    !important;
    background-position: center 13px             !important;
    background-repeat: no-repeat                 !important;
    border-radius: 0          !important;
    left: 0                   !important;
    z-index: 2                !important;
}

/* 50px gap between sticky strip and "Резерв ID" */
