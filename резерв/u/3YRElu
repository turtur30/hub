<script>
/* Swipe down to close bottom-sheet popups (v3 — smooth) */
(function() {
    var SHEET_SEL = '.popup-fullmenu, .popup-fullmenu-1, .popup-fullmenu-2, ' +
                   '.popup-fullmenu-3, .popup-fullmenu-4, .popup-fullmenu-5, .popup-fullmenu-6';
    var THRESHOLD   = 80;
    var EASE_CLOSE  = 'transform 0.28s cubic-bezier(0.4, 0, 0.8, 1)';   /* ease-in  */
    var EASE_CANCEL = 'transform 0.35s cubic-bezier(0.25, 0.8, 0.25, 1)'; /* ease-out */

    function getMaxScroll(sheet) {
        var max = sheet.scrollTop;
        sheet.querySelectorAll('*').forEach(function(el) {
            if (el.scrollTop > max) max = el.scrollTop;
        });
        return max;
    }

    function closeAll() {
        document.querySelectorAll(SHEET_SEL).forEach(function(s) {
            s.classList.remove('active');
        });
        if (typeof $ !== 'undefined') { $('.overlay').fadeOut(150); }
    }

    function initSwipe(sheet) {
        var startY = 0, startScroll = 0, delta = 0, dragging = false;

        sheet.addEventListener('touchstart', function(e) {
            /* Stop any ongoing animation */
            sheet.style.transition = 'none';
            sheet.style.transform  = sheet.style.transform || '';
            startY      = e.touches[0].clientY;
            startScroll = getMaxScroll(sheet);
            delta       = 0;
            dragging    = false;
        }, { passive: true });

        sheet.addEventListener('touchmove', function(e) {
            delta = e.touches[0].clientY - startY;

            if (delta > 0 && startScroll <= 1) {
                dragging = true;
                /* Resistance: full speed up to 60px, then slow down */
                var visual = delta < 60
                    ? delta
                    : 60 + (delta - 60) * 0.35;
                sheet.style.transition = 'none';
                sheet.style.transform  = 'translateY(' + visual + 'px)';

            } else if (dragging) {
                /* Direction reversed — snap back */
                dragging = false;
                sheet.style.transition = EASE_CANCEL;
                sheet.style.transform  = 'translateY(0)';
            }
        }, { passive: true });

        sheet.addEventListener('touchend', function() {
            if (dragging && delta > THRESHOLD) {
                /* Animate off-screen first, THEN remove active class */
                sheet.style.transition = EASE_CLOSE;
                sheet.style.transform  = 'translateY(110%)';
                setTimeout(function() {
                    closeAll();
                    /* Reset silently after class is removed */
                    sheet.style.transition = 'none';
                    sheet.style.transform  = '';
                    /* Restore default transition on next frame */
                    requestAnimationFrame(function() {
                        sheet.style.transition = '';
                    });
                }, 290);
            } else {
                /* Snap back smoothly */
                sheet.style.transition = EASE_CANCEL;
                sheet.style.transform  = 'translateY(0)';
                setTimeout(function() {
                    sheet.style.transition = '';
                    sheet.style.transform  = '';
                }, 360);
            }
            dragging = false;
            delta    = 0;
        }, { passive: true });
    }

    function setup() {
        document.querySelectorAll(SHEET_SEL).forEach(initSwipe);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setup);
    } else {
        setup();
    }
})();
</script>
